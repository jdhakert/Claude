{
  "name": "barready",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:generate": "pnpm --filter @barready/db generate",
    "db:migrate": "pnpm --filter @barready/db migrate",
    "db:seed": "pnpm --filter @barready/db seed",
    "test": "pnpm -r test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
